<?xml version="1.0" encoding="UTF-8"?>
<Configuration packages="net.minecraftforge.fml.core.network.handshake,net.minecraftforge.fml.common.network.handshake">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t/%level] [%logger]: %msg%n" />
        </Console>
    </Appenders>
    <Loggers>
        <Root level="debug">
            <AppenderRef ref="Console" />
        </Root>
    </Loggers>
</Configuration>
